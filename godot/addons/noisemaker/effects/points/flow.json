{
  "name": "Flow",
  "namespace": "points",
  "func": "flow",
  "starter": false,
  "tags": [
    "sim"
  ],
  "description": "Agent-based luminosity flow field with behaviors",
  "globals": {
    "heightTex": {
      "type": "surface",
      "default": "none",
      "colorModeUniform": "fieldActive"
    },
    "diffuseTex": {
      "type": "surface",
      "default": "none",
      "colorModeUniform": "diffuseActive"
    },
    "stateSize": {
      "type": "int",
      "default": 256,
      "uniform": "stateSize"
    },
    "behavior": {
      "type": "int",
      "default": 1,
      "uniform": "behavior",
      "choices": {
        "none": 0,
        "obedient": 1,
        "crosshatch": 2,
        "unruly": 3,
        "chaotic": 4,
        "randomMix": 5,
        "meandering": 10
      }
    },
    "stride": {
      "type": "float",
      "default": 10,
      "uniform": "stride",
      "min": 1,
      "max": 1000
    },
    "strideDeviation": {
      "type": "float",
      "default": 0.05,
      "uniform": "strideDeviation",
      "min": 0,
      "max": 0.5
    },
    "kink": {
      "type": "float",
      "default": 1,
      "uniform": "kink",
      "min": 0,
      "max": 10
    },
    "quantize": {
      "type": "boolean",
      "default": false,
      "uniform": "quantize"
    },
    "inputWeight": {
      "type": "float",
      "default": 100,
      "uniform": "inputWeight",
      "min": 0,
      "max": 100
    }
  },
  "uniformLayouts": {
    "agent": {
      "resolution": {
        "slot": 0,
        "components": "xy"
      },
      "time": {
        "slot": 0,
        "components": "z"
      },
      "stride": {
        "slot": 0,
        "components": "w"
      },
      "strideDeviation": {
        "slot": 1,
        "components": "x"
      },
      "kink": {
        "slot": 1,
        "components": "y"
      },
      "quantize": {
        "slot": 1,
        "components": "z"
      },
      "inputWeight": {
        "slot": 1,
        "components": "w"
      },
      "behavior": {
        "slot": 2,
        "components": "x"
      },
      "diffuseActive": {
        "slot": 2,
        "components": "z"
      },
      "fieldActive": {
        "slot": 2,
        "components": "y"
      }
    },
    "passthrough": {
      "resolution": {
        "slot": 0,
        "components": "xy"
      }
    }
  },
  "passes": [
    {
      "name": "agent",
      "program": "agent",
      "inputs": {
        "xyzTex": "global_xyz",
        "velTex": "global_vel",
        "rgbaTex": "global_rgba",
        "inputTex": "inputTex",
        "heightTex": "heightTex",
        "diffuseTex": "diffuseTex",
        "baseColorTex": "global_flow_base_color"
      },
      "uniforms": {
        "diffuseActive": "diffuseActive",
        "fieldActive": "fieldActive",
        "behavior": "behavior",
        "stride": "stride",
        "strideDeviation": "strideDeviation",
        "kink": "kink",
        "quantize": "quantize",
        "inputWeight": "inputWeight"
      },
      "outputs": {
        "outXYZ": "global_xyz",
        "outVel": "global_vel",
        "outRGBA": "global_rgba",
        "outBaseColor": "global_flow_base_color"
      },
      "drawBuffers": 4
    },
    {
      "name": "passthrough",
      "program": "passthrough",
      "inputs": {
        "inputTex": "inputTex"
      },
      "outputs": {
        "fragColor": "outputTex"
      }
    }
  ],
  "textures": {
    "global_flow_base_color": {
      "width": {
        "param": "stateSize",
        "inherit": true,
        "default": 256
      },
      "height": {
        "param": "stateSize",
        "inherit": true,
        "default": 256
      },
      "format": "rgba8"
    }
  },
  "paramAliases": {
    "fieldTex": "heightTex"
  }
}
