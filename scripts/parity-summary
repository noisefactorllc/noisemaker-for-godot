#!/usr/bin/env bash
# scripts/parity-summary [case-id ...]
# Requires bash 4.3 or newer for the bounded 'wait -n' job overlap; on older
# bash the guard degrades to batched overlap and results are unchanged.
#
# Renders the current authority's manifest cases with this port (Godot) and
# compares each with the authority's golden, then prints one summary line:
#
#   PARITY-SUMMARY {"expected":N,"executed":N,"exact":N,"strict":N,"near":N,"defer":N,"skip":N,"fail":N,"missing":N}
#
# Case selection:
#   - With case-id arguments, only those cases are expected and counted.
#   - Without arguments, every program in parity/ledger.json is expected.
#
# Buckets (each case lands in exactly one):
#   exact   — candidate PNG byte-identical to the golden, comparator exit 0.
#   strict  — comparator exit 0 within 2.001/0.98, but not byte-identical.
#   near    — comparator exit 0 within the named case's existing sweep policy,
#             but outside 2.001/0.98.
#   defer   — reserved summary field; no case may be deferred from rendering.
#   skip    — the case cannot execute here: no parity/programs/<case>.dsl, no
#             Godot binary (GODOT env, /Applications/Godot.app, or godot in
#             PATH), or no node to mint a current golden.
#   fail    — rendered and compared, comparator exit 1, not covered by a
#             recorded tolerated mismatch.
#   missing — expected but no candidate PNG was produced.
#
# executed = exact + strict + near + fail. Exit 0 iff every expected case was
# rendered and passed its existing sweep policy; defer/skip/fail/missing block.
#
# Environment: the reference engine checkout (the goldens' authority) comes
# from NM_REFERENCE_ROOT; when it is unset, the entrypoint pin-clones the
# reference itself at the bound revision (see below). Goldens and graphs are
# minted fresh via parity/export-and-render.mjs on every run at that revision.
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# Bounds for network and engine steps: a runner whose environment stalls a
# silent fetch, install or launch burns the engine command's deadline with
# no trace. Prefer the host's timeout command (macOS ships gtimeout from
# coreutils, not timeout); fall back to node's own spawn timeout, which
# every gate host has because the gate runs node itself. A stall exits 124
# (timeout(1)'s code) as a named failure, early and in time for the mint.
bound_ms () { # $1 = milliseconds; rest = command
  # The engine command's deadline bounds the whole gate (see GATE_START_MS
  # below): a fixed bound longer than that deadline's remaining time lets the
  # harness kill arrive first as a bare command_timeout with no stage named
  # (observed on a cold runner). Cap every bound at the remaining time minus
  # the same 10s margin the renders reserve, and refuse to launch once too
  # little of it remains, so every overrun ends as this named 124 inside the
  # deadline. Standalone (no gate clock, as in the bound_ms contract tests)
  # the bound stays exactly as large as requested.
  local planned="$1" remaining=""
  if [ -n "${NM_GATE_DEADLINE_MS:-}" ]; then
    remaining=$(( NM_GATE_DEADLINE_MS - ( $(now_ms) - GATE_START_MS ) - 10000 ))
    if [ "$remaining" -lt 5000 ]; then
      echo "DIAG: the gate's engine deadline has too little time left for: ${*:2}" >&2
      return 124
    fi
    if [ "$planned" -gt "$remaining" ]; then set -- "$remaining" "${@:2}"; fi
  fi
  # GNU timeout waits forever when the child ignores TERM, so the bound itself
  # can hang (red probe: timeout 2 'trap "" TERM; sleep 12' exits after 12s, not
  # 2s). Escalate to SIGKILL 10s after the bound on every branch so a stalled
  # browser or engine launch always ends the bounded command.
  if command -v timeout >/dev/null 2>&1; then timeout -k 10 "$(( $1 / 1000 ))" "${@:2}"; rc=$?
  elif command -v gtimeout >/dev/null 2>&1; then gtimeout -k 10 "$(( $1 / 1000 ))" "${@:2}"; rc=$?
  else BOUND_MS="$1" node -e 'const{spawnSync}=require("child_process");const r=spawnSync(process.argv[1],process.argv.slice(2),{stdio:"inherit",timeout:Number(process.env.BOUND_MS),killSignal:"SIGKILL"});process.exit(r.status===null?124:r.status)' "${@:2}"; rc=$?
  fi
  # The escalation kill makes timeout(1) exit 137 (128+SIGKILL), not 124;
  # the bound's named-failure contract is 124, so map the kill back.
  if [ "$rc" -eq 137 ]; then rc=124; fi
  return "$rc"
}
# Diagnostics must reach both streams: contract tests assert them on stderr,
# and a runner receipt that captures only stdout must still show where the
# gate is when a step stalls.
diag () {
  echo "$*"
  echo "$*" >&2
  printf '%s %s\n' "$(date -u +%H:%M:%S)" "$*" >>"$GATE_JOURNAL" 2>/dev/null || true
}

# tagj mirrors diag for per-case stage lines: the same line goes to stdout and
# the gate journal (with a timestamp). The per-case phases run with their
# output captured in per-case logs, so a run killed by the engine command's
# deadline would otherwise leave no trace naming the case and stage that were
# active at the kill; the journal makes the killed run's last stage visible.
tagj () {
  echo "$*"
  printf '%s %s\n' "$(date -u +%H:%M:%S)" "$*" >>"$GATE_JOURNAL" 2>/dev/null || true
}
# A runner that kills the engine command on its deadline may lose the captured
# output, so the gate also journals every diagnostic line inside the checkout.
# A later invocation on the same workspace replays the previous invocation's
# journal when that run never completed, which makes the killed run's last
# stage visible even when its stdout was lost. A completed run records its
# exit code, so only a killed run triggers a replay.
GATE_JOURNAL="$ROOT/parity/out/gate-journal.log"
mkdir -p "$ROOT/parity/out" 2>/dev/null || true

# Provision the comparator's python environment while the reference
# provisioning below and the mint phase run: on a cold runner the venv
# install is the longest silent step, and a harness that bounds the whole
# gate command kills it as a bare command_timeout with no stage named once
# the cumulative cold time exceeds its deadline. The ensure script is
# idempotent; run.sh and run_samples.sh source it again per render and then
# find the environment ready.
# The gate clock is set here, before the background provisioning below, so
# that the ensure script's bound caps every provisioning step at the
# deadline's remaining time: a subshell forked before the clock existed
# would run in standalone mode with full fixed bounds, and a slow registry
# could outlive the engine command's deadline as a bare command_timeout
# with no stage named.
now_ms () { # prints epoch milliseconds; portable across GNU and BSD date
  local s
  s="$(date +%s%3N 2>/dev/null)"
  case "$s" in *[!0-9]*) echo "$(( $(date +%s) * 1000 ))" ;; *) echo "$s" ;; esac
}
GATE_START_MS="$(now_ms)"
# Export the gate's deadline and start so child scripts (run.sh,
# run_samples.sh and the comparator provisioning they source) can cap their
# own fixed bounds at the deadline's remaining time too. Only a caller that
# sets NM_ENGINE_DEADLINE_MS has a deadline; without one the gate runs every
# case and each step keeps its own fixed bound.
NM_GATE_DEADLINE_MS="${NM_ENGINE_DEADLINE_MS:-}"
export NM_GATE_DEADLINE_MS NM_GATE_START_MS="$GATE_START_MS"
COMPARE_PY_PID=""
if ! python3 -c 'import numpy, PIL' >/dev/null 2>&1 \
   && [ -f "$ROOT/parity/ensure_compare_python.sh" ]; then
  COMPARE_PY_DONE="$ROOT/parity/out/venv-provision.done"
  COMPARE_PY_FAIL="$ROOT/parity/out/venv-provision.fail"
  rm -f "$COMPARE_PY_DONE" "$COMPARE_PY_FAIL"
  (
    if bash "$ROOT/parity/ensure_compare_python.sh" "$ROOT" \
        > "$ROOT/parity/out/venv-provision.log" 2>&1; then
      touch "$COMPARE_PY_DONE"
    else
      touch "$COMPARE_PY_FAIL"
    fi
  ) &
  COMPARE_PY_PID=$!
fi
# The reference cache swap lock's held flag and its release helper live here
# so both EXIT traps (this one and the later combined one) can release the
# lock, whatever killed the run: a holder that died with the file behind it
# must not brick the next invocation. Releasing clears the flag so a later
# exit cannot remove a live successor's lock.
CACHE_LOCK_HELD=""
release_cache_lock () {
  if [ -n "$CACHE_LOCK_HELD" ]; then
    rm -f "$CACHE.lock/lock"
    CACHE_LOCK_HELD=""
  fi
}
trap 'rc=$?; release_cache_lock; printf "GATE-COMPLETED rc=%s\n" "$rc" >>"$GATE_JOURNAL" 2>/dev/null || true' EXIT
if [ -s "$GATE_JOURNAL" ] && ! tail -n 3 "$GATE_JOURNAL" 2>/dev/null | grep -q '^GATE-COMPLETED'; then
  echo "[GATE-JOURNAL] the previous invocation was killed before completing; its last stages"
  echo "[GATE-JOURNAL] the previous invocation was killed before completing; its last stages" >&2
  tail -n 12 "$GATE_JOURNAL" 2>/dev/null | while IFS= read -r line; do
    echo "[GATE-JOURNAL] $line"
    echo "[GATE-JOURNAL] $line" >&2
  done
fi
: > "$GATE_JOURNAL" 2>/dev/null || true
# Emit a start marker before anything else: a runner whose harness kills the
# engine command before the gate's first diagnostic line leaves a result with
# no stage named (observed as a bare command_timeout). This marker, or its
# absence, makes the next attempt's evidence decisive about whether the gate
# ever started.
diag "[GATE] start (deadline ${NM_GATE_DEADLINE_MS:-none}${NM_GATE_DEADLINE_MS:+ms}, cases ${1:-all})"
# The gate clock was started above the comparator provisioning fork so every
# background bound shares this deadline (see the comment there). render_bound
# reads the same clock below.
render_bound_ms () { # prints the milliseconds a render may still use
  local remaining
  if [ -z "$NM_GATE_DEADLINE_MS" ]; then echo 170000; return; fi
  remaining=$(( NM_GATE_DEADLINE_MS - ( $(now_ms) - GATE_START_MS ) - 10000 ))
  if [ "$remaining" -gt 170000 ]; then remaining=170000; fi
  if [ "$remaining" -lt 30000 ]; then remaining=0; fi
  echo "$remaining"
}
if [ -z "${NM_REFERENCE_ROOT:-}" ]; then
  # Acquire the reference cache swap lock, or fail named. The lock file
  # records the holder's pid: a live holder blocks the swap as before, and a
  # holder that died between acquiring and releasing (a runner deadline kill
  # during the bounded fetch or npm install, where no EXIT trap can run)
  # leaves the file behind without its pid existing. Such a stale lock must
  # not brick the gate, so a dead holder's lock is removed and acquisition is
  # retried once. A live holder's lock, an empty file (a holder between
  # creating the lock and writing its pid), and unreadable content all stay
  # held, keeping the swap mutually exclusive.
  acquire_cache_lock () {
    if ( set -o noclobber; echo "$$" > "$CACHE.lock/lock" ) 2>/dev/null; then
      CACHE_LOCK_HELD=1
      return 0
    fi
    local pid
    pid=$(head -c 32 "$CACHE.lock/lock" 2>/dev/null)
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    if kill -0 "$pid" 2>/dev/null; then return 1; fi
    diag "parity-summary: the reference cache lock was left by dead pid $pid; taking it"
    rm -f "$CACHE.lock/lock"
    ( set -o noclobber; echo "$$" > "$CACHE.lock/lock" ) 2>/dev/null || return 1
    CACHE_LOCK_HELD=1
    return 0
  }
  # Self-contained authority resolution: pin-clone the reference engine at the
  # revision the port's goldens are bound to (no machine-specific paths; the
  # clone is cached and reused across runs). Cache reuse requires the pinned
  # HEAD AND a clean tree — a dirty or tampered cache is re-cloned, never
  # trusted. The swap is locked so concurrent invocations cannot move the
  # cache out from under each other.
  PIN=6f98d26ab84f17ba7fb154bb74252d6362736f89
  CACHE="${PARITY_REFERENCE_CACHE:-${TMPDIR:-/tmp}/noisemaker-reference}"
  export NM_REFERENCE_ROOT="$CACHE"
  usable=0
  if [ -f "$CACHE/.git/HEAD" ]; then
    if [ "$(git -C "$CACHE" rev-parse HEAD 2>/dev/null)" = "$PIN" ] \
       && [ -z "$(git -C "$CACHE" status --porcelain 2>/dev/null)" ]; then
      usable=1
    elif [ -z "$(git -C "$CACHE" status --porcelain 2>/dev/null)" ]; then
      # The cache is clean but at another revision (a moved pin): reuse it
      # instead of discarding it. A fast-forward keeps node_modules and the
      # browser cache, so a pin move costs one bounded fetch instead of a
      # full cold re-clone plus a fresh npm install — the difference between
      # fitting a runner's engine deadline and being killed mid-provision.
      # The reuse is still fail-closed: after the fetch the checkout must
      # land exactly on the pin with a clean tree, or the cache is discarded
      # and the cold re-clone below runs as before.
      mkdir -p "$CACHE.lock" 2>/dev/null || true
      if ! acquire_cache_lock; then
        diag "parity-summary: another invocation holds the reference cache lock ($CACHE.lock)"
        echo 'PARITY-SUMMARY {"expected":0,"executed":0,"exact":0,"strict":0,"near":0,"defer":0,"skip":0,"fail":0,"missing":0}'
        exit 2
      fi
      if bound_ms 30000 git -C "$CACHE" fetch -q origin "$PIN" 2>/dev/null \
         && git -C "$CACHE" checkout -q --detach "$PIN" 2>/dev/null \
         && [ "$(git -C "$CACHE" rev-parse HEAD 2>/dev/null)" = "$PIN" ] \
         && [ -z "$(git -C "$CACHE" status --porcelain 2>/dev/null)" ]; then
        usable=1
        diag "[REFERENCE] fast-forwarded the clean cache to the pin $PIN"
        # A reused cache keeps node_modules from its earlier install, but only
        # if a previous run managed to install it; ensure it the same bounded,
        # fail-closed way the fresh-clone path does, still under the lock.
        if [ ! -f "$CACHE/node_modules/playwright/package.json" ]; then
          diag "[REFERENCE] installing playwright@1.63.0 into the reference clone"
          if ! ( cd "$CACHE" && bound_ms 45000 npm install --no-save "playwright@1.63.0" >/dev/null 2>&1 ) \
             || [ ! -f "$CACHE/node_modules/playwright/package.json" ]; then
            diag "parity-summary: playwright unavailable for the reference harness (set NM_REFERENCE_ROOT to a prepared checkout)"
            rm -rf "$CACHE"
            release_cache_lock
            echo 'PARITY-SUMMARY {"expected":0,"executed":0,"exact":0,"strict":0,"near":0,"defer":0,"skip":0,"fail":0,"missing":0}'
            exit 2
          fi
        fi
      fi
      release_cache_lock
    fi
  fi
  if [ "$usable" -ne 1 ]; then
    diag "[REFERENCE] pin-cloning noisefactorllc/noisemaker at $PIN into $CACHE"
    rm -rf "$CACHE.tmp" 2>/dev/null || true
    mkdir -p "$CACHE.lock" 2>/dev/null || true
    if ! acquire_cache_lock; then
      diag "parity-summary: another invocation holds the reference cache lock ($CACHE.lock)"
      echo 'PARITY-SUMMARY {"expected":0,"executed":0,"exact":0,"strict":0,"near":0,"defer":0,"skip":0,"fail":0,"missing":0}'
      exit 2
    fi
    # A runner whose network accepts connections but never answers stalls a
    # silent fetch or npm install until the engine command's deadline burns
    # with no trace. Bound each network step (see bound_ms above): a stall
    # exits as a named failure early, in time for the mint.
    if ! ( git init -q "$CACHE.tmp" \
           && git -C "$CACHE.tmp" remote add origin https://github.com/noisefactorllc/noisemaker \
           && bound_ms 20000 git -C "$CACHE.tmp" fetch -q --depth 1 origin "$PIN" ) 2>/dev/null; then
      rm -rf "$CACHE.tmp" 2>/dev/null || true
      if ! bound_ms 20000 git clone -q https://github.com/noisefactorllc/noisemaker "$CACHE.tmp" 2>/dev/null; then
        diag "parity-summary: cannot obtain the reference engine (set NM_REFERENCE_ROOT to a local checkout)"
        release_cache_lock
        echo 'PARITY-SUMMARY {"expected":0,"executed":0,"exact":0,"strict":0,"near":0,"defer":0,"skip":0,"fail":0,"missing":0}'
        exit 2
      fi
    fi
    git -C "$CACHE.tmp" checkout -q --detach "$PIN" || {
      diag "parity-summary: pinned revision $PIN not reachable"
      rm -rf "$CACHE.tmp"; release_cache_lock
      echo 'PARITY-SUMMARY {"expected":0,"executed":0,"exact":0,"strict":0,"near":0,"defer":0,"skip":0,"fail":0,"missing":0}'
      exit 2
    }
    rm -rf "$CACHE"
    mv "$CACHE.tmp" "$CACHE"
    # The reference harness's minting path imports playwright, resolving from
    # the harness's own directory inside the clone ($NM_REFERENCE_ROOT/vendor/
    # shade-mcp/harness); a fresh clone ships without node_modules. Install a
    # pinned version so minted reference goldens do not drift with the browser
    # bundled by whatever the registry happens to serve.
    if [ ! -f "$CACHE/node_modules/playwright/package.json" ]; then
      diag "[REFERENCE] installing playwright@1.63.0 into the reference clone"
      if ! ( cd "$CACHE" && bound_ms 45000 npm install --no-save "playwright@1.63.0" >/dev/null 2>&1 ) \
         || [ ! -f "$CACHE/node_modules/playwright/package.json" ]; then
        diag "parity-summary: playwright unavailable for the reference harness (set NM_REFERENCE_ROOT to a prepared checkout)"
        # Drop the half-prepared cache so the next run re-clones and retries
        # the install instead of trusting a cache that cannot mint. Release
        # the lock too: an exit here that left the lock file behind would
        # brick the gate, with every later invocation exiting 2 on the held
        # lock until the file was deleted by hand.
        rm -rf "$CACHE"
        release_cache_lock
        echo 'PARITY-SUMMARY {"expected":0,"executed":0,"exact":0,"strict":0,"near":0,"defer":0,"skip":0,"fail":0,"missing":0}'
        exit 2
      fi
    fi
    release_cache_lock
  fi
  diag "[REFERENCE] using $NM_REFERENCE_ROOT"
fi

# The minting harness launches Chromium through playwright. A prepared
# reference checkout can carry the playwright module without the browser
# binaries launch needs, and a fresh clone never has them, so ensure the
# module's own pinned browser build when the module is present. The install
# is idempotent: with the build already present it validates it and exits 0
# without downloading. A checkout without the module fails at mint as before.
if [ -f "$NM_REFERENCE_ROOT/node_modules/playwright/cli.js" ]; then
  diag "[REFERENCE] ensuring the playwright chromium build"
  # Mints launch headless, so the headless shell is the only browser build the
  # gate needs; installing it alone keeps the cold-cache download inside a
  # bounded command. A non-headless launch needs the full build. The install
  # is idempotent and its output is kept: a slow or blocked download must be
  # visible in a timed-out command, not silently dropped.
  case "${SHADE_HEADLESS:-1}" in
    0|false) shell_flag='' ;;
    *) shell_flag='--only-shell' ;;
  esac
  # A runner whose network silently drops the download connection stalls the
  # install until the engine command's deadline burns with no trace. Bound
  # it (see bound_ms above): a stall exits as a named failure in time for
  # the mint, and a healthy slow download still fits.
  case "${SHADE_HEADLESS:-1}" in
    0|false) shell_flag='' ;;
    *) shell_flag='--only-shell' ;;
  esac
  if ! ( cd "$NM_REFERENCE_ROOT" && bound_ms 45000 node node_modules/playwright/cli.js install chromium $shell_flag ); then
    diag "parity-summary: the playwright chromium build is unavailable or its install did not finish (set PLAYWRIGHT_BROWSERS_PATH to an installed browser root)"
    echo 'PARITY-SUMMARY {"expected":0,"executed":0,"exact":0,"strict":0,"near":0,"defer":0,"skip":0,"fail":0,"missing":0}'
    exit 2
  fi
fi

GODOT_BIN="${GODOT:-}"
GODOT_MIN="4.7"
godot_version_ok () { # $1 = binary; prints nothing, rc 0 iff >= GODOT_MIN
  local v major minor
  # The probe is bounded: a binary that hangs on --version must fail named, not
  # burn the runner's outer command deadline as a bare command_timeout.
  v="$(bound_ms 10000 "$1" --version 2>/dev/null | head -n 1 | grep -oE '[0-9]+\.[0-9]+' | head -n 1)"
  major="${v%%.*}"; minor="${v#*.}"
  [ "${major:-0}" -gt 4 ] && return 0
  [ "${major:-0}" -eq 4 ] && [ "${minor:-0}" -ge 7 ] && return 0
  return 1
}
if [ -z "$GODOT_BIN" ]; then
  for c in /Applications/Godot.app/Contents/MacOS/Godot \
           "$ROOT/.host-tools/Godot.app/Contents/MacOS/Godot" godot; do
    bin="$(command -v "$c" 2>/dev/null || true)"
    [ -z "$bin" ] && [ -x "$c" ] && bin="$c"
    if [ -n "$bin" ] && godot_version_ok "$bin"; then GODOT_BIN="$bin"; break; fi
  done
fi
PY="${PYTHON:-python3}"

# Build the expected case list.
if [ "$#" -gt 0 ]; then
  CASES=("$@")
else
  CASES=()
  while IFS= read -r line; do CASES+=("$line"); done < <("$PY" - "$ROOT/parity/ledger.json" <<'PYEOF'
import json, sys
# LF line ends on every host: a Windows Python would print CRLF into the case names.
sys.stdout.reconfigure(newline="\n")
try:
    ledger = json.load(open(sys.argv[1]))
except Exception as e:
    sys.stderr.write(f"parity-summary: unreadable manifest {sys.argv[1]}: {e}\n")
    raise SystemExit(3)
if not isinstance(ledger, list) or not ledger:
    sys.stderr.write(f"parity-summary: manifest {sys.argv[1]} is empty or not a list\n")
    raise SystemExit(3)
n = 0
for e in ledger:
    name = e.get("program") if isinstance(e, dict) else None
    if name:
        print(name); n += 1
if n == 0:
    sys.stderr.write(f"parity-summary: manifest {sys.argv[1]} has no program entries\n")
    raise SystemExit(3)
PYEOF
)
  # A failed or empty process substitution must not pass vacuously with
  # expected:0 — bash `while read < <(cmd)` cannot carry cmd's status, so
  # require at least one case after the loop.
  [ "${#CASES[@]}" -gt 0 ] || {
    echo 'PARITY-SUMMARY {"expected":0,"executed":0,"exact":0,"strict":0,"near":0,"defer":0,"skip":0,"fail":0,"missing":0}'
    exit 2
  }
fi
# The supervisor splits long required runs into bounded shard invocations
# (see .nm-test-shards): with the shard variables set, this invocation
# renders only its own slice of the expected cases, and together the shards
# cover every case. Without them the whole manifest runs exactly as before.
if [ -n "${NM_SHARD_COUNT:-}" ] && [ -n "${NM_SHARD_INDEX:-}" ]; then
  ZEROS='PARITY-SUMMARY {"expected":0,"executed":0,"exact":0,"strict":0,"near":0,"defer":0,"skip":0,"fail":0,"missing":0}'
  case "${NM_SHARD_COUNT}${NM_SHARD_INDEX}" in
    *[!0-9]*) echo "$ZEROS"; exit 2 ;;
  esac
  if [ "$NM_SHARD_COUNT" -lt 1 ] || [ "$NM_SHARD_INDEX" -lt 0 ] || [ "$NM_SHARD_INDEX" -ge "$NM_SHARD_COUNT" ]; then
    echo "$ZEROS"; exit 2
  fi
  SHARD_CASES=()
  i=0
  for c in "${CASES[@]}"; do
    [ $((i % NM_SHARD_COUNT)) -eq "$NM_SHARD_INDEX" ] && SHARD_CASES+=("$c")
    i=$((i+1))
  done
  if [ "${#SHARD_CASES[@]}" -eq 0 ]; then
    echo "$ZEROS"; exit 0
  fi
  CASES=("${SHARD_CASES[@]}")
fi
EXPECTED=${#CASES[@]}

classify () { # $1 = case; $2/$3 = published tolerance/SSIM
  local case="$1"
  PARITY_ROOT="$ROOT" "$PY" - "$case" "$2" "$3" "${4:-}" <<'PYEOF'
import json, sys, os, math
case, tolerance, ssim_min = sys.argv[1], float(sys.argv[2]), float(sys.argv[3])
sample = sys.argv[4]
root = os.environ["PARITY_ROOT"]
report_name = (case + ".report.t" + sample + ".json" if sample else
               case + ".parity-summary.report.json")
report_path = os.path.join(root, "parity", "out", report_name)
gold_path = os.path.join(root, "parity", "out", case + ".golden" + (".t" + sample if sample else "") + ".png")
cand_path = os.path.join(root, "parity", "out", case + ".candidate" + (".t" + sample if sample else "") + ".png")
if not all(os.path.exists(path) for path in (report_path, gold_path, cand_path)):
    print("missing"); raise SystemExit
try:
    report = json.load(open(report_path))
    max_diff = float(report["max_abs_diff"])
    ssim = float(report["ssim"])
    policy_matches = (float(report["tolerance"]) == tolerance
                      and float(report["ssim_min"]) == ssim_min)
except (OSError, KeyError, TypeError, ValueError, OverflowError):
    print("fail"); raise SystemExit
if (report.get("name") != case + ("_t" + sample if sample else "") or report.get("passed") is not True
        or not policy_matches or not math.isfinite(max_diff)
        or not math.isfinite(ssim) or max_diff > tolerance or ssim < ssim_min):
    print("fail"); raise SystemExit
if open(gold_path, "rb").read() == open(cand_path, "rb").read():
    print("exact")
elif max_diff <= 2.001 and ssim >= 0.98:
    print("strict")
else:
    print("near")
PYEOF
}

exact=0; strict=0; near=0; defer=0; skip=0; fail=0; missing=0; executed=0
mkdir -p "$ROOT/parity/out"
LOCKDIR="$ROOT/parity/out/.parity-summary.lock"
if ! mkdir "$LOCKDIR" 2>/dev/null; then
  diag "parity-summary: output directory is held by another run ($LOCKDIR)"
  echo "PARITY-SUMMARY {\"expected\":$EXPECTED,\"executed\":0,\"exact\":0,\"strict\":0,\"near\":0,\"defer\":0,\"skip\":$EXPECTED,\"fail\":0,\"missing\":0}"
  exit 2
fi
# One EXIT trap must hold all three actions (output lock, reference cache
# lock, completion journal): a later trap assignment would replace
# the journal's completion marker and every completed run would then look
# killed to the next invocation.
trap 'rc=$?; rmdir "$LOCKDIR" 2>/dev/null || true; release_cache_lock; printf "GATE-COMPLETED rc=%s\n" "$rc" >>"$GATE_JOURNAL" 2>/dev/null || true' EXIT
# Cold runs are deadline-bound: the browser build download plus three
# sequential case mints and renders can exceed the engine command's budget,
# while the same steps fit easily when the cases overlap. Each case is
# self-contained (per-case output paths and logs), so the heavy per-case work
# runs concurrently under a bounded job count. Default keeps every required
# case of the native profile overlapping; NM_CASE_JOBS=1 restores sequential
# execution.
# Phase 1 (concurrent): mint each case's golden and graph with the browser
# harness. Browsers parallelize cleanly; this is the cold path's dominant
# cost. Phase 2 (sequential): render and classify with Godot — concurrent
# Godot renders starve each other on one GPU/display, so they never overlap.
mint_case () {
  local case="$1"
  while :; do
    prog="$ROOT/parity/programs/$case.dsl"
    gold="$ROOT/parity/out/$case.golden.png"
    graph="$ROOT/parity/out/$case.graph.json"
    case_run=0; case_every=0
    if policy_line="$(bash "$ROOT/parity/sweep.sh" --policy "$case" 2>/dev/null)"; then
      IFS=$'\t' read -r _ _ _ case_run case_every <<< "$policy_line"
    fi
    if [ ! -f "$prog" ]; then break; fi
    if ! rm -f "$gold" "$graph" "$ROOT/parity/out/$case.golden.t"*.png \
        "$ROOT/parity/out/$case.candidate.t"*.png "$ROOT/parity/out/$case.report.t"*.json; then
      tagj "[SKIP] $case: cannot clear previous golden and graph"
      break
    fi
    if command -v node >/dev/null 2>&1; then
      tagj "[MINT] $case (reference $NM_REFERENCE_ROOT)"
      mint_args=(--size 256 --backend webgl2)
      if [ "${case_run:-0}" -gt 0 ]; then
        mint_args+=(--run-seconds "$case_run" --sample-every "$case_every")
      fi
      # A stalled browser mint would otherwise burn the engine command's
      # whole deadline silently; bound it (see bound_ms above) so the stall
      # exits as a named failure early, in time for the mint phase.
      if ! bound_ms 90000 node "$ROOT/parity/export-and-render.mjs" "$prog" "$ROOT/parity/out" \
          "${mint_args[@]}" > "$ROOT/parity/out/$case.mint.log" 2>&1; then
        if ! rm -f "$gold" "$graph" "$ROOT/parity/out/$case.golden.t"*.png; then
          tagj "[SKIP] $case: failed mint left artifacts that could not be cleared"
        fi
      fi
    fi
    break
  done
}
run_case () {
  local case="$1"
  # Single-pass loop: the body's 'break' statements end this invocation
  # the way they ended a loop iteration before.
  while :; do
  if ! policy_line="$(bash "$ROOT/parity/sweep.sh" --policy "$case")"; then
    fail=$((fail+1)); echo "[FAIL] $case: policy lookup failed"; break
  fi
  IFS=$'\t' read -r case_tol case_ssim case_reason case_run case_every <<< "$policy_line"
  if [ -z "$case_tol" ] || [ -z "$case_ssim" ]; then
    fail=$((fail+1)); echo "[FAIL] $case: policy lookup returned no bounds"; break
  fi
  prog="$ROOT/parity/programs/$case.dsl"
  gold="$ROOT/parity/out/$case.golden.png"
  graph="$ROOT/parity/out/$case.graph.json"
  if [ ! -f "$prog" ]; then
    skip=$((skip+1)); echo "[SKIP] $case: no parity/programs/$case.dsl"; break
  fi
  if [ ! -f "$graph" ] || { [ "${case_run:-0}" -eq 0 ] && [ ! -f "$gold" ]; }; then
    skip=$((skip+1)); echo "[SKIP] $case: current golden and graph could not be minted"; break
  fi
  if [ -z "$GODOT_BIN" ]; then
    skip=$((skip+1)); echo "[SKIP] $case: no Godot binary (set GODOT)"; break
  fi
  if [ "${case_run:-0}" -gt 0 ]; then
    tagj "[RENDER] $case (${case_run}s every ${case_every}s)"
    render_bound="$(render_bound_ms)"
    if [ "$render_bound" -eq 0 ]; then
      fail=$((fail+1)); executed=$((executed+1))
      tagj "[FAIL] $case: the engine command's deadline left no time for the render"
      break
    fi
    if NM_RENDER_BOUND_MS="$render_bound" GODOT="$GODOT_BIN" bash "$ROOT/parity/run_samples.sh" "$case" "$case_tol" \
        "$case_ssim" "$case_run" "$case_every" 256 \
        > "$ROOT/parity/out/$case.parity-summary.log" 2>&1; then
      run_rc=0
    else
      run_rc=$?
    fi
    sample_bucket=exact
    t=$case_every
    while [ "$t" -le "$case_run" ]; do
      if [ ! -f "$ROOT/parity/out/$case.golden.t$t.png" ] || \
         [ ! -f "$ROOT/parity/out/$case.candidate.t$t.png" ]; then
        sample_bucket=missing; break
      fi
      if [ ! -f "$ROOT/parity/out/$case.report.t$t.json" ]; then
        sample_bucket=fail; break
      fi
      sample_result="$(classify "$case" "$case_tol" "$case_ssim" "$t")"
      case "$sample_result" in
        exact) ;;
        strict) [ "$sample_bucket" = exact ] && sample_bucket=strict ;;
        near) sample_bucket=near ;;
        *) sample_bucket=fail; break ;;
      esac
      t=$((t + case_every))
    done
    if [ "$sample_bucket" = missing ]; then
      missing=$((missing+1)); tagj "[MISSING] $case: timed sample missing"
    elif [ "$run_rc" -ne 0 ] || [ "$sample_bucket" = fail ]; then
      fail=$((fail+1)); executed=$((executed+1))
      tagj "[FAIL] $case: timed samples failed (runner exit $run_rc)"
    else
      executed=$((executed+1))
      case "$sample_bucket" in
        exact) exact=$((exact+1)); tagj "[PASS] $case (timed exact)" ;;
        strict) strict=$((strict+1)); tagj "[PASS] $case (timed strict)" ;;
        near) near=$((near+1)); tagj "[NEAR] $case (timed: $case_reason)" ;;
      esac
    fi
    break
  fi
  tagj "[RENDER] $case"
  if ! rm -f "$ROOT/parity/out/$case.parity-summary.report.json" "$ROOT/parity/out/$case.report.json"; then
    skip=$((skip+1)); tagj "[SKIP] $case: cannot clear previous comparator reports"; break
  fi
  render_bound="$(render_bound_ms)"
  if [ "$render_bound" -eq 0 ]; then
    fail=$((fail+1)); executed=$((executed+1))
    tagj "[FAIL] $case: the engine command's deadline left no time for the render"
    break
  fi
  # A batched pre-render already produced this case's candidate, so run.sh
  # only compares and classifies (SKIP_RENDER=1); the case still fails named
  # when the batch left no candidate. Unbatched runs keep the render launch.
  skip_render=0
  case " $NM_BATCHED_CASES " in *" $case "*) skip_render=1 ;; esac
  if NM_RENDER_BOUND_MS="$render_bound" GODOT="$GODOT_BIN" SKIP_RENDER="$skip_render" bash "$ROOT/parity/run.sh" "$case" "$case_tol" "$case_ssim" 256 \
      > "$ROOT/parity/out/$case.parity-summary.log" 2>&1; then
    run_rc=0
  else
    run_rc=$?
    tagj "[NONZERO] $case: run.sh exited nonzero (see parity/out/$case.parity-summary.log)"
  fi
  # run.sh writes report.json on both paths (compare.py --report always runs).
  if [ ! -f "$ROOT/parity/out/$case.candidate.png" ]; then
    missing=$((missing+1)); tagj "[MISSING] $case: no candidate produced"; break
  fi
  if [ ! -f "$ROOT/parity/out/$case.report.json" ]; then
    # Candidate exists but compare.py died before its report: fail, not missing.
    fail=$((fail+1)); executed=$((executed+1))
    tagj "[FAIL] $case: comparator wrote no report (see parity/out/$case.parity-summary.log)"
    break
  fi
  if [ "$run_rc" -ne 0 ]; then
    fail=$((fail+1)); executed=$((executed+1))
    tagj "[FAIL] $case: renderer or comparator exited $run_rc"
    break
  fi
  cp "$ROOT/parity/out/$case.report.json" "$ROOT/parity/out/$case.parity-summary.report.json" 2>/dev/null || true
  case "$(classify "$case" "$case_tol" "$case_ssim")" in
    exact)   exact=$((exact+1)); executed=$((executed+1)); tagj "[PASS] $case (exact)";;
    strict)  strict=$((strict+1)); executed=$((executed+1)); tagj "[PASS] $case (strict)";;
    near)    near=$((near+1)); executed=$((executed+1)); tagj "[NEAR] $case ($case_reason)";;
    fail)    fail=$((fail+1)); executed=$((executed+1)); tagj "[FAIL] $case";;
    missing) missing=$((missing+1)); tagj "[MISSING] $case";;
    *)       fail=$((fail+1)); executed=$((executed+1)); tagj "[FAIL] $case: classification failed";;
  esac
  break
  done
}

# Phase 1: mints overlap (bounded), each captured in its own log.
mint_jobs="${NM_CASE_JOBS:-8}"
mint_pids=()
for case in "${CASES[@]}"; do
  mint_case "$case" > "$ROOT/parity/out/$case.mintphase.log" 2>&1 &
  mint_pids+=($!)
  if [ "${#mint_pids[@]}" -ge "$mint_jobs" ]; then
    if ! wait -n 2>/dev/null; then wait; mint_pids=(); else
      mint_pids=("${mint_pids[@]:1}")
    fi
  fi
done
wait

# The comparator's python environment must be ready before the first render:
# it provisioned in the background (overlapping the reference provisioning
# and the mints), so wait on its sentinel — earlier reaps can invalidate the
# pid — and fail named, not silently, if it failed or ran out of time.
if [ -n "$COMPARE_PY_PID" ]; then
  i=0
  while [ ! -f "${COMPARE_PY_DONE:-/nonexistent}" ] \
     && [ ! -f "${COMPARE_PY_FAIL:-/nonexistent}" ] && [ "$i" -lt 150 ]; do
    sleep 1; i=$((i+1))
  done
  if [ ! -f "${COMPARE_PY_DONE:-/nonexistent}" ]; then
    echo "FAIL: the comparator python environment did not provision (parity/out/venv-provision.log):"
    cat "$ROOT/parity/out/venv-provision.log" 2>/dev/null || true
    exit 124
  fi
fi

# One cold engine launch pays the engine's startup and import cost. The
# native profile's three required cases each paid it again, and on a slow
# cold runner the last render could outlive the engine command's deadline
# before its own bound fired. The engine renders many requests in one
# launch (--batch-manifest), so pre-render every non-sampled case of this
# run in one bounded launch; each per-case run.sh then classifies with
# SKIP_RENDER=1 and never launches the engine itself. Single-case runs and
# timed-sweep cases keep the per-case launch path.
NM_BATCHED_CASES=""
batch_cases=()
if [ -n "$GODOT_BIN" ]; then
  for case in "${CASES[@]}"; do
    if policy_line="$(bash "$ROOT/parity/sweep.sh" --policy "$case" 2>/dev/null)"; then
      IFS=$'\t' read -r _ _ _ case_run _ <<< "$policy_line"
      if [ "${case_run:-0}" -eq 0 ] && [ -f "$ROOT/parity/programs/$case.dsl" ] \
         && [ -f "$ROOT/parity/out/$case.graph.json" ]; then
        batch_cases+=("$case")
      fi
    fi
  done
fi
if [ "${#batch_cases[@]}" -gt 1 ]; then
  # The batch launch opens real windows (see run.sh): on a display-less Linux
  # runner it stalls, so launch under a virtual display (xvfb-run) when one is
  # installed, and fail named otherwise (see run.sh for the full contract).
  window_cmd=""
  if [ -n "${NM_WINDOW_CMD:-}" ]; then
    window_cmd="$NM_WINDOW_CMD"
  elif [ "$(uname -s)" = "Linux" ] && [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
    if command -v xvfb-run >/dev/null 2>&1; then
      window_cmd="xvfb-run -a"
    else
      echo "FAIL: no window session (DISPLAY and WAYLAND_DISPLAY unset) and no xvfb-run on PATH; the Godot render needs a windowed engine launch on a GPU host"
      exit 124
    fi
  fi
  manifest="$ROOT/parity/out/batch-manifest.json"
  if ! python3 - "$ROOT" "$manifest" "${batch_cases[@]}" <<'PYEOF'
import json, sys
root, out_path = sys.argv[1], sys.argv[2]
out_dir = root + "/parity/out"
entries = []
for name in sys.argv[3:]:
    # Mirror run.sh's per-case flags: only the media case renders with its
    # media fixture; every other case renders the plain graph.
    entry = {
        "name": name,
        "graph": out_dir + "/" + name + ".graph.json",
        "out": out_dir + "/" + name + ".candidate.png",
        "size": 256,
        "run_seconds": 0,
        "sample_every": 0,
    }
    if name == "media":
        entry["media_fixture"] = True
    entries.append(entry)
with open(out_path, "w") as f:
    f.write(json.dumps({"entries": entries}, indent=2) + "\n")
PYEOF
  then
    echo "FAIL: cannot write the batch render manifest"; exit 2
  fi
  # Stale candidates must never classify: clear each batched case's
  # candidate and reports so a failed batch launch leaves a named
  # "no candidate produced" failure, not a stale pass.
  for case in "${batch_cases[@]}"; do
    rm -f "$ROOT/parity/out/$case.candidate.png" "$ROOT/parity/out/$case.report.json" \
          "$ROOT/parity/out/$case.parity-summary.report.json" || true
  done
  render_bound="$(render_bound_ms)"
  if [ "$render_bound" -eq 0 ]; then
    echo "FAIL: the engine command's deadline left no time for the batch render"; exit 124
  fi
  tagj "[RENDER] batch (${#batch_cases[@]} cases in one launch)"
  if ! bound_ms "$render_bound" $window_cmd "$GODOT_BIN" --path "$ROOT/godot" \
        --script res://addons/noisemaker/tools/render_graph.gd --position 5000,5000 -- \
        --batch-manifest "$manifest" > "$ROOT/parity/out/batch-render.log" 2>&1; then
    tagj "[NONZERO] batch render exited nonzero (see parity/out/batch-render.log)"
  fi
  NM_BATCHED_CASES=" ${batch_cases[*]} "
fi
export NM_BATCHED_CASES

# Phase 2: Godot renders and comparisons run sequentially — concurrent Godot
# instances starve each other on one GPU/display.
case_jobs=1
case_pids=()
for case in "${CASES[@]}"; do
  run_case "$case" > "$ROOT/parity/out/$case.case.log" 2>&1 &
  case_pids+=($!)
  if [ "${#case_pids[@]}" -ge "$case_jobs" ]; then
    if ! wait -n 2>/dev/null; then wait; case_pids=(); else
      # wait -n reaped one child; drop its pid. Statuses are judged from the
      # per-case logs below, not from exit codes.
      case_pids=("${case_pids[@]:1}")
    fi
  fi
done
wait

# Aggregate the buckets from each case's own tags. A case's terminal tag is
# authoritative: SKIP and MISSING never coexist with PASS, and a FAIL tag
# always marks the case's final verdict.
for case in "${CASES[@]}"; do
  log="$ROOT/parity/out/$case.case.log"
  # The children ran with their output captured per phase; replay both logs
  # so the gate's stdout still carries every per-case stage line in order.
  [ -f "$ROOT/parity/out/$case.mintphase.log" ] && cat "$ROOT/parity/out/$case.mintphase.log"
  [ -f "$log" ] && cat "$log"
  bucket="skip"
  if [ -f "$log" ]; then
    if    grep -q '^\[FAIL\]' "$log"; then bucket="fail"
    elif  grep -q '^\[MISSING\]' "$log"; then bucket="missing"
    elif  grep -q '^\[NEAR\]' "$log"; then bucket="near"
    elif  grep -q '^\[PASS\] .*exact' "$log"; then bucket="exact"
    elif  grep -q '^\[PASS\]' "$log"; then bucket="strict"
    elif  grep -q '^\[SKIP\]' "$log"; then bucket="skip"
    fi
  fi
  case "$bucket" in
    exact)   exact=$((exact+1)); executed=$((executed+1)) ;;
    strict)  strict=$((strict+1)); executed=$((executed+1)) ;;
    near)    near=$((near+1)); executed=$((executed+1)) ;;
    fail)    fail=$((fail+1)); executed=$((executed+1)) ;;
    missing) missing=$((missing+1)) ;;
    *)       skip=$((skip+1)) ;;
  esac
done

echo "PARITY-SUMMARY {\"expected\":$EXPECTED,\"executed\":$executed,\"exact\":$exact,\"strict\":$strict,\"near\":$near,\"defer\":$defer,\"skip\":$skip,\"fail\":$fail,\"missing\":$missing}"
if [ "$executed" -eq "$EXPECTED" ] && [ "$((exact+strict+near))" -eq "$EXPECTED" ] \
   && [ "$defer" -eq 0 ] && [ "$skip" -eq 0 ] \
   && [ "$fail" -eq 0 ] && [ "$missing" -eq 0 ]; then
  exit 0
fi
exit 1
